{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "class.schema.json",
  "title": "twD20 職業內容檔",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "maxLevel", "subclassLevel", "defaultSubclass", "tagline", "quote", "primaryAbility", "spellcasting",
    "hitDie", "saves", "skills", "weapons", "tools", "armor", "equipment", "features"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "feature.schema.json#/definitions/id", "description": "職業 key，與存檔的 class 值相同：不可改名。" },
    "name": { "type": "string", "minLength": 1, "description": "職業名稱。" },
    "maxLevel": { "$ref": "feature.schema.json#/definitions/level", "description": "內容收錄到的最高等級；特性表列數依此產生。" },
    "subclassLevel": { "$ref": "feature.schema.json#/definitions/level", "description": "選擇子職的等級。" },
    "defaultSubclass": { "$ref": "feature.schema.json#/definitions/id", "description": "舊存檔沒有子職欄位時使用的子職 ID。" },
    "tagline": { "type": "string", "minLength": 1, "description": "創角頁籤的一句話簡介。" },
    "quote": { "type": "string", "minLength": 1, "description": "創角頁籤的引文。" },
    "primaryAbility": {
      "description": "關鍵屬性。all：全部都是（顯示為「敏捷與感知」）；any：擇一（顯示為「力量或敏捷」）。",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "$ref": "#/definitions/abilities" } } },
        { "type": "object", "additionalProperties": false, "required": ["any"], "properties": { "any": { "type": "array", "$ref": "#/definitions/abilities", "minItems": 2 } } }
      ]
    },
    "spellcasting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["progression"],
      "description": "施法進度，決定法術位。",
      "properties": {
        "progression": {
          "enum": ["full", "half", "pact", "none"],
          "description": "full：全施法者；half：半施法者（兼職時等級除以 2 無條件進位）；pact：契約魔法（環位另計）；none：不施法。"
        }
      }
    },
    "hitDie": { "enum": [6, 8, 10, 12], "description": "生命骰面數。" },
    "saves": { "type": "array", "$ref": "#/definitions/abilities", "minItems": 2, "maxItems": 2, "description": "豁免熟練項。" },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choose", "from"],
      "properties": {
        "choose": { "type": "integer", "minimum": 1, "maximum": 4, "description": "可選技能數。" },
        "from": {
          "anyOf": [
            { "const": "any", "description": "任選。" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
          ],
          "description": "可選技能清單（名稱須存在於技能提示表），或 any。"
        }
      }
    },
    "weapons": { "type": "string", "minLength": 1, "description": "武器熟練項（顯示與 PDF 文字）。" },
    "tools": { "type": "string", "minLength": 1, "description": "工具熟練項（顯示文字）。" },
    "armor": { "type": "string", "minLength": 1, "description": "護甲訓練（顯示與 PDF 文字）。" },
    "proficiencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weapons", "armor"],
      "description": "武器、護甲與工具熟練的機制資料（weapons／armor／tools 文字只供顯示）。網站依此判斷武器與護甲是否熟練、武器精通可選的武器與職業工具欄位。",
      "properties": {
        "weapons": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["simple", "martial"] }, "description": "熟練的武器類別。" },
            "martialWithProperty": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["輕型", "靈巧"] }, "description": "另外熟練具有任一屬性的軍用武器（武器資料的屬性名稱）。" }
          }
        },
        "armor": { "type": "array", "uniqueItems": true, "items": { "enum": ["light", "medium", "heavy", "shield"] }, "description": "護甲訓練；沒有時寫 []。" },
        "tools": {
          "description": "職業工具熟練。fixed：固定的工具；chooseFrom：從工具組（tool-data.js 的工具組 ID）選 count 種。field 是存檔欄位 ID（選擇時為前綴，後接序號）：不可改名。",
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["fixed", "field"],
              "properties": { "fixed": { "type": "string", "minLength": 1 }, "field": { "$ref": "feature.schema.json#/definitions/id" } }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["chooseFrom", "count", "field"],
              "properties": {
                "chooseFrom": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "feature.schema.json#/definitions/id" } },
                "count": { "type": "integer", "minimum": 1 },
                "field": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*-$" }
              }
            }
          ]
        }
      }
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "description": "起始裝備，A、B 二擇一。職業頁的（A）列由建置依 items 組成，套組名稱自動加上內容物提示框；職業頁與快速創角依此加入物品欄。",
      "properties": {
        "A": {
          "description": "裝備組合：items 與 gold；有兩種以上組合時寫 options（例如戰士的力量型、敏捷型）。",
          "oneOf": [
            { "$ref": "#/definitions/equipmentSet" },
            {
              "type": "object", "additionalProperties": false, "required": ["options"],
              "properties": {
                "options": {
                  "type": "array", "minItems": 2,
                  "items": {
                    "type": "object", "additionalProperties": false, "required": ["id", "label", "items", "gold"],
                    "properties": {
                      "id": { "$ref": "feature.schema.json#/definitions/id", "description": "組合 ID，快速創角的草稿以此記錄選擇：不可改名。" },
                      "label": { "type": "string", "minLength": 1, "description": "組合名稱（例如「力量型」），顯示在（A）列與選擇視窗。" },
                      "items": { "$ref": "#/definitions/equipmentItems" },
                      "gold": { "$ref": "#/definitions/gold" }
                    }
                  }
                }
              }
            }
          ]
        },
        "B": {
          "type": "object", "additionalProperties": false, "required": ["gold"],
          "properties": { "gold": { "$ref": "#/definitions/gold" } }
        }
      }
    },
    "progression": {
      "type": "object",
      "description": "特性表的職業專屬欄位（等級、熟練加值、職業特性三欄自動產生）。欄位名稱可在文字中以 {名稱|…} 引用。",
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "byLevel"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "description": "表頭文字。" },
          "byLevel": {
            "type": "object",
            "description": "只寫數值有變化的等級；null 顯示為「-」。",
            "propertyNames": { "pattern": "^[1-9][0-9]?$" },
            "additionalProperties": { "anyOf": [{ "type": "number" }, { "type": "null" }] }
          },
          "format": { "type": "string", "pattern": "\\{\\}", "description": "顯示格式，{} 代入數值，例如 +{}、{}d6、1d{}（數值是骰面）。" }
        }
      }
    },
    "values": {
      "type": "object",
      "description": "其他可在文字中以 {名稱|…} 引用的數值，例如 \"{rageDamage}d6\"。公式只能用數字、d、四則運算、max()／min()／floor()（無條件捨去）／ceil()（無條件進位）與 {數值}；另可引用屬性調整值 {strModifier}…{chaModifier}（沒有屬性值時視為 0）。跑團顯示要加字樣時寫 { formula, format }（例如 { formula: \"{rageUses}\", format: \"{} 次\" }）。跑團顯示依等級變化的文字時寫 { byLevel: { 5: 文字 } }。",
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "minLength": 1, "description": "數值公式，例如 \"max(1, {chaModifier})\"。" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["formula", "format"],
            "description": "帶跑團顯示格式的公式：{} 代入計算結果，例如 { formula: \"8 + {proficiencyBonus} + {wisModifier}\", format: （DC {}） } 顯示為「（DC 13）」。",
            "properties": {
              "formula": { "type": "string", "minLength": 1, "description": "數值公式，寫法同字串公式。" },
              "format": { "type": "string", "pattern": "\\{\\}", "description": "跑團顯示格式，{} 代入計算結果；前後空白也保留（夾在中文之間時用來和數值區隔）。" },
              "blank": { "type": "string", "minLength": 1, "description": "公式用到的屬性值或等級未填時改顯示的文字；keep 表示保留職業頁文字。省略時屬性調整值視為 0、等級視為 1。" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["byLevel"],
            "description": "依等級的文字：從該等級起跑團模式改顯示此文字；未達最低等級時保留頁面文字。只能用在文字，不可用於公式或次數。",
            "properties": {
              "byLevel": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "pattern": "^[1-9][0-9]?$" },
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["fromTable"],
            "description": "由能力文字中的表格組出跑團文字，表格只寫一次。只能用在文字，不可用於公式或次數。",
            "properties": {
              "fromTable": {
                "type": "object",
                "additionalProperties": false,
                "required": ["feature", "row"],
                "properties": {
                  "feature": { "type": "string", "description": "表格所在的能力 ID（本職業或子職）。" },
                  "table": { "type": "integer", "minimum": 1, "description": "該能力文字中的第幾個表格，預設 1。" },
                  "row": { "type": "string", "minLength": 1, "description": "每一列的文字樣板，{1}、{2}… 代入該列第 1、2… 欄，例如「{1} 環消耗 {2} 點」。" },
                  "join": { "type": "string", "description": "列與列之間的分隔文字，例如「；」。" },
                  "end": { "type": "string", "description": "最後加上的文字，例如「。」。" }
                }
              }
            }
          }
        ]
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "feature.schema.json#/definitions/feature" },
      "description": "職業能力，依等級排列。"
    },
    "appendix": {
      "type": "array",
      "minItems": 1,
      "description": "附錄：沒有等級的參考小節（例如術士的「超魔法選項」、契術師的「魔能祈喚選項」），接在所有能力之後。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "anyOf": [{ "required": ["text"] }, { "required": ["parts"] }],
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "標題，例如「超魔法選項」。" },
          "kind": {
            "enum": ["metamagic", "invocations"],
            "description": "網站以小節建立選擇卡片的附錄：metamagic 為術士超魔法（小節的 detail 是消耗），invocations 為契術師魔能祈喚（小節的 level、repeatable、spell）。卡片勾選框依小節順序編號並寫進存檔，只能在最後新增小節。"
          },
          "text": { "$ref": "feature.schema.json#/definitions/text", "description": "內文，可用「#### 標題」小節（不可有表格）；有 parts 時寫在小節之前的說明（可省略），不可再用「#### 」。" },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/appendixPart" },
            "description": "附錄小節：依序接在 text 之後。有小節需要跑團按鈕（例如魔能斬擊）時，該附錄的小節全部寫在這裡以保留順序。"
          }
        }
      }
    },
    "srd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overview", "features"],
      "description": "SRD 5.2.1 繁中直譯：職業頁的「SRD 版」（唯讀，頁尾註明譯自 SRD 5.2.1）。有這個區塊的職業，職業頁標題列才顯示「網站版｜SRD 版」切換。只限公開內容包。",
      "properties": {
        "overview": { "$ref": "feature.schema.json#/definitions/srdText", "description": "「職業」頁籤的 SRD 版：核心特質表、成為某職業、職業特性前言與特性表（不依等級篩選，同網站版的創角資訊與特性表）。" },
        "features": { "$ref": "feature.schema.json#/definitions/srdFeatures", "description": "「特性」頁籤的 SRD 版：1–20 級職業能力。" },
        "appendix": {
          "type": "array",
          "minItems": 1,
          "description": "附錄頁籤（超魔、魔祈）的 SRD 版：原文寫在職業能力之後的小節（術士「超魔法選項」、契術師「魔能祈喚選項」）。職業有 srd 時，每個寫了 kind 的 appendix 都要有一項，以 name 對應。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "text"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "description": "小節標題，須與本職業某個寫了 kind 的 appendix 的 name 相同；顯示在該頁籤 SRD 版的最上方。" },
              "text": { "$ref": "feature.schema.json#/definitions/srdText", "description": "小節全文，可用「#### 」小標（各選項的名稱），不可用「### 」小標與側欄。" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "gold": { "type": "integer", "minimum": 0, "description": "金幣數，顯示為「N 金幣」。" },
    "equipmentSet": {
      "type": "object", "additionalProperties": false, "required": ["items", "gold"],
      "properties": { "items": { "$ref": "#/definitions/equipmentItems" }, "gold": { "$ref": "#/definitions/gold" } }
    },
    "equipmentItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1, "description": "物品：裝備說明的品名，數量寫成「名稱 ×n」（例如「箭矢 ×20」）。" },
          {
            "type": "object", "additionalProperties": false, "required": ["name", "weight"],
            "description": "裝備說明沒有的物品（例如法術書），加入物品欄時當自訂物品。",
            "properties": { "name": { "type": "string", "minLength": 1 }, "weight": { "type": "number", "minimum": 0, "description": "每件磅數。" } }
          },
          {
            "type": "object", "additionalProperties": false, "required": ["choose"],
            "description": "擇一的物品：tools 從工具組（tool-data.js 的工具組 ID）選，from 從列出的品名選；兩者擇一寫。",
            "properties": {
              "choose": { "type": "string", "minLength": 1, "description": "顯示文字，例如「樂器擇一」「聖徽」。" },
              "tools": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "feature.schema.json#/definitions/id" } },
              "from": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            },
            "oneOf": [{ "required": ["tools"] }, { "required": ["from"] }]
          }
        ]
      }
    },
    "appendixPart": {
      "type": "object",
      "description": "附錄小節：輸出成通用小節，標題為「名稱（先決條件：…）」。沒有等級；按鈕須寫 level。",
      "additionalProperties": false,
      "required": ["name", "text"],
      "properties": {
        "id": { "$ref": "feature.schema.json#/definitions/id", "description": "小節 ID（與能力 ID 共用、全職業唯一），有 actions 時必填；舊版已有的照抄。" },
        "name": { "type": "string", "minLength": 1, "description": "小節名稱，例如「刃之魔契」。超魔法與魔能祈喚的名稱會寫進存檔（已選清單）與跑團偏好，不可改字。" },
        "prerequisite": { "type": "string", "minLength": 1, "description": "先決條件，顯示為標題後的「（先決條件：…）」，例如「契術師等級 5+，刃之魔契祈喚」。" },
        "detail": { "type": "string", "minLength": 1, "description": "接在名稱後的標題文字（沒有先決條件時），例如超魔法的「－消耗：1 術法點」。" },
        "level": { "$ref": "feature.schema.json#/definitions/level", "description": "可選擇此小節的最低職業等級（例如魔能祈喚的「契術師等級 5+」）；省略為 1。" },
        "repeatable": { "const": true, "description": "可重複選擇（例如苦痛魔爆）。" },
        "spell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "use"],
          "description": "選擇後給予的法術，例如幽影護甲的法師護甲。法術 ID 須存在於 spell-id-baseline.json。",
          "properties": {
            "id": { "$ref": "feature.schema.json#/definitions/id", "description": "法術 ID（spellId）。" },
            "use": { "enum": ["at-will", "once"], "description": "at-will：隨意施放，不耗法術位；once：每次長休可免費施放 1 次。" }
          }
        },
        "text": { "$ref": "feature.schema.json#/definitions/text", "description": "內文（不可有表格）；「#### 標題」只輸出標題，不另包小節。" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "feature.schema.json#/definitions/action" },
          "description": "跑團按鈕：說明為此小節，按鈕文字預設為小節名稱，須寫 level。"
        }
      },
      "if": { "required": ["actions"] },
      "then": { "required": ["id"] }
    },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["力量", "敏捷", "體質", "智力", "感知", "魅力"] }
    }
  }
}
