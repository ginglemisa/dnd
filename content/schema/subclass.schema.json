{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "subclass.schema.json",
  "title": "twD20 子職內容檔",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "class", "name", "shortName", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "feature.schema.json#/definitions/id", "description": "子職 ID（同一職業內唯一），會寫進存檔：不可改名。" },
    "class": { "$ref": "feature.schema.json#/definitions/id", "description": "所屬職業 ID。" },
    "name": { "type": "string", "minLength": 1, "description": "子職全名。" },
    "shortName": { "type": "string", "minLength": 1, "description": "標題後綴用的簡稱，顯示為「（簡稱子職）」。" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "feature.schema.json#/definitions/feature" },
      "description": "子職能力，依等級排列。"
    }
  }
}
