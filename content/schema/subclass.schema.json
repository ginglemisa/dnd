{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "subclass.schema.json",
  "title": "twD20 子職內容檔",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "class", "name", "shortName", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "feature.schema.json#/definitions/id", "description": "子職 ID（同一職業內唯一），會寫進存檔：不可改名。" },
    "class": { "$ref": "feature.schema.json#/definitions/id", "description": "所屬職業 ID。" },
    "name": { "type": "string", "minLength": 1, "description": "子職全名。" },
    "shortName": { "type": "string", "minLength": 1, "description": "標題後綴用的簡稱，顯示為「（簡稱子職）」。" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "feature.schema.json#/definitions/feature" },
      "description": "子職能力，依等級排列。"
    },
    "srd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "intro", "features"],
      "description": "SRD 5.2.1 繁中直譯：職業頁「特性」頁籤 SRD 版的子職段落，接在職業能力之後。所屬職業須有 srd 區塊；只限公開內容包。",
      "properties": {
        "title": { "type": "string", "minLength": 1, "description": "子職標題，例如「野蠻人子職：狂戰士道途」。" },
        "intro": { "$ref": "feature.schema.json#/definitions/srdText", "description": "標題下的子職說明（不可有小標或表格）。" },
        "features": { "$ref": "feature.schema.json#/definitions/srdFeatures", "description": "子職能力（等級不低於職業的 subclassLevel）。" }
      }
    }
  }
}
